# Mrs. Dangu API — environment variables
# Local / Railway / any host: set ONE of the modes below.

# ----- MODE 1: Direct provider keys (use this on Railway) -----
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# ----- MODE 2: Replit AI Integrations (auto-set on Replit) -----
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# AI_INTEGRATIONS_GEMINI_API_KEY=

# Optional
PORT=8080
